  "law_record": {
    "id": "NRS-484B-213-2c",
    "title": "Limitations on overtaking on left side (2)(c)",
    "text": "A vehicle must not be driven to the left side of the highway at any time: When the view is obstructed upon approaching within 100 feet of any bridge, viaduct or tunnel. Subsection 2 does not apply upon a one-way highway.",
    "source": "NRS 484B.213(2)(c); with 484B.213(3)"
  },
  "summary": {
    "activation_conditions": [
      "the subject is within 100 feet of a bridge, viaduct or tunnel",
      "the view is obstructed there",
      "the subject drives left of the centre of the highway"
    ],
    "exceptions": [
      "the rule does not apply on a one-way highway"
    ],
    "id": "NRS-484B-213-2c",
    "residue": [
      "'the view is obstructed' is a judgement element about sight distance at the approach"
    ],
    "source": "NRS 484B.213(2)(c); with 484B.213(3)",
    "subject": "driver",
    "theme": "overtaking",
    "tier": "Q",
    "timing_requirements": [
