  "law_record": {
    "id": "NRS-484B-477-1b",
    "title": "Stopping, standing or parking in alley (1)(b)",
    "text": "Unless otherwise provided by ordinance of the local authority having jurisdiction, a person shall not: Stop, stand or park a vehicle in any other alley in such a manner, or under such conditions as to leave available less than 10 feet of the width of the alley for the free movement of vehicular traffic.",
    "source": "NRS 484B.477(1)(b)"
  },
  "summary": {
    "activation_conditions": [
      "the subject stops, stands or parks in an alley",
      "less than 10 feet of the alley's width is left free for vehicular traffic"
    ],
    "exceptions": [
      "unless a local ordinance provides otherwise"
    ],
    "id": "NRS-484B-477-1b",
