  "law_record": {
    "id": "LVMC-11-40-180-B",
    "title": "Sidewalk riding (B)",
    "text": "The Director of Public Works is authorized to erect signs on any other sidewalk or any roadway in the City prohibiting the riding of bicycles, electric bicycles, or electric scooters thereon by any person when the Director after consultation with the City Traffic Engineer and the Las Vegas Metropolitan Police Department determines that the use of bicycles, electric bicycles, or electric scooters on the sidewalk or roadway in question will impede or interfere with the flow of pedestrian or vehicular traffic, and when such signs are in place it shall be unlawful for any person to disobey the same.",
    "source": "LVMC 11.40.180(B)"
  },
