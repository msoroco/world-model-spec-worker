  "law_record": {
    "id": "NRS-484B-450-1j",
    "title": "Stopping, standing or parking prohibited in specified places (1)(j)",
    "text": "A person shall not stop, stand or park a vehicle, except when necessary to avoid conflict with other traffic or in compliance with law or the directions of a police officer or official traffic-control device, in any of the following places: Within 20 feet of a driveway entrance to any fire station and, on the side of a highway opposite the entrance to any fire station, within 75 feet of that entrance.",
    "source": "NRS 484B.450(1)(j)"
  },
  "summary": {
    "activation_conditions": [
      "a fire station driveway entrance is on the highway",
      "the subject stops, stands or parks within 20 feet of it, or within 75 feet of it on the opposite side of the highway"
    ],
    "exceptions": [
      "when necessary to avoid conflict with other traffic",
