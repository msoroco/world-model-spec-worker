  "law_record": {
    "id": "NRS-484B-257-1",
    "title": "Vehicle entering intersection marked stop or yield (1)",
    "text": "Except when traffic is being controlled by a police officer or a traffic-control signal: When proper signs have been erected, the driver of a vehicle shall stop or yield at a clearly marked stop line or, if there is none, before entering the crosswalk on the near side of the intersection or, if there is none, then at the point nearest the intersection where the driver has a view of approaching traffic on the through highway. After having stopped or, in the event of a yield sign, slowed or stopped, the driver shall yield the right-of-way to other vehicles which have entered the intersection from such through highway or which are approaching so closely on such through highway as to constitute an immediate hazard during the time such driver is moving across or within the intersection.",
    "source": "NRS 484B.257(1)"
  },
  "summary": {
    "activation_conditions": [
      "proper stop or yield signs have been erected at the subject's approach",
      "the subject approaches that intersection",
      "traffic is not being controlled by a police officer or a traffic-control signal"
    ],
    "exceptions": [
      "when traffic is being controlled by a police officer",
      "when traffic is being controlled by a traffic-control signal"
    ],
    "id": "NRS-484B-257-1",
    "residue": [
      "'immediate hazard' is a judgement element"
    ],
    "source": "NRS 484B.257(1)",
    "subject": "driver",
    "theme": "intersections_and_right_of_way",
    "tier": "Q",
    "timing_requirements": [
      {
        "kind": "ordering",
        "requirement": "stop or yield at the reference point first, then enter"
      },
      {
        "kind": "continuous",
        "requirement": "the yield duty runs for the whole time the subject is moving across or within the intersection, not only at entry"
      }
    ],
    "title": "Vehicle entering intersection marked stop or yield (1)"
  },
