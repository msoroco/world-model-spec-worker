  "law_record": {
    "id": "NRS-484B-250-4",
    "title": "Vehicle approaching or entering intersection (4)",
    "text": "When a vehicle enters an intersection controlled by a traffic-control signal which is installed and has its vehicular signals uncovered, but is inoperative at the time the vehicle enters the intersection, the driver of the vehicle shall proceed as if a stop sign had been erected at each entrance to the intersection and shall stop at a clearly marked stop line or, if there is none, before entering the crosswalk on the near side of the intersection or, if there is none, at the point nearest the intersection where the driver has a view of approaching traffic on the through highway. After making such a stop, the driver shall proceed cautiously, yielding to vehicles which have previously completed a stop or are within the intersection.",
    "source": "NRS 484B.250(4)"
  },
  "summary": {
    "activation_conditions": [
      "the intersection is controlled by a traffic-control signal that is installed with uncovered vehicular signals",
      "the signal is inoperative when the subject enters"
    ],
    "exceptions": [],
    "id": "NRS-484B-250-4",
    "residue": [
      "'proceed cautiously' after the stop is a judgement element"
    ],
    "source": "NRS 484B.250(4)",
    "subject": "driver",
    "theme": "intersections_and_right_of_way",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "ordering",
        "requirement": "stop first, then proceed: the halt precedes entry, and the yield is owed to whoever completed a stop earlier"
      },
      {
        "kind": "duration",
        "requirement": "a full halt at the stop line, not a slowing"
      },
      {
        "kind": "span",
        "requirement": "deciding 'previously completed a stop' needs the other vehicles' histories, so the trace must cover their approaches too"
      }
    ],
    "title": "Vehicle approaching or entering intersection (4)"
  },
