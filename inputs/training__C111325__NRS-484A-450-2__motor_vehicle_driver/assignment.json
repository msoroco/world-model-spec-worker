  "law_record": {
    "id": "NRS-484A-450-2",
    "title": "Designation of through highways and intersections requiring stop or yield (2)",
    "text": "Every driver of a vehicle approaching a stop intersection indicated by a stop sign shall stop before entering the crosswalk on the near side of the intersection or, if there is no crosswalk, shall stop at a clearly marked stop line, or if none, then at the point nearest the intersecting highway where the driver has a view of approaching traffic on the intersecting highway before entering the intersection.",
    "source": "NRS 484A.450(2)"
  },
  "summary": {
    "activation_conditions": [
      "the subject is the driver of a vehicle",
      "the subject is approaching an intersection whose approach is indicated by a stop sign"
    ],
    "exceptions": [],
    "id": "NRS-484A-450-2",
    "residue": [
      "which of the three halting references applies is a map question (is there a crosswalk, is there a marked stop line); the third is the first point from which approaching traffic is in the subject's line of sight (rel.visible), and only as good as the source's line-of-sight test"
    ],
    "source": "NRS 484A.450(2)",
    "subject": "driver",
    "theme": "intersections_and_right_of_way",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "ordering",
        "requirement": "the halt occurs before the footprint crosses the halting reference — the near-side crosswalk, or the stop line if there is no crosswalk, or the point where the view of the intersecting highway opens if there is neither"
      },
      {
        "kind": "duration",
        "requirement": "a full stop, not a rolling minimum: speed at or below the drv.stopped epsilon for at least its span parameter"
      },
      {
        "kind": "ordering",
        "requirement": "the halt precedes entering the intersection"
      }
    ],
    "title": "Designation of through highways and intersections requiring stop or yield (2)"
  },
