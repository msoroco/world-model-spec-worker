  "law_record": {
    "id": "LVMC-11-43-010-C1",
    "title": "Operation of vehicles within a roundabout (C)(1)",
    "text": "The following regulations pertain to the operation of vehicles within a roundabout: The operator of a vehicle who intends to exit a roundabout: Shall use the left lane to turn left or complete a U-turn.",
    "source": "LVMC 11.43.010(C)(1)"
  },
  "summary": {
    "activation_conditions": [
      "the subject is in a multi-lane roundabout",
      "the subject intends to turn left or complete a U-turn"
    ],
    "exceptions": [],
    "id": "LVMC-11-43-010-C1",
    "residue": [
      "'intends to exit' is intention; the exit taken is the observable substitute"
    ],
    "source": "LVMC 11.43.010(C)(1)",
    "subject": "driver",
    "theme": "roundabouts",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "span",
        "requirement": "the intended exit is shown by the exit actually taken, so the whole passage from entry to exit is needed"
      },
      {
        "kind": "continuous",
        "requirement": "the left lane must be held through the circulating movement"
      }
    ],
    "title": "Operation of vehicles within a roundabout (C)(1)"
