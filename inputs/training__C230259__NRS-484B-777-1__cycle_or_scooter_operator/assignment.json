  "law_record": {
    "id": "NRS-484B-777-1",
    "title": "Operating bicycle, electric bicycle or electric scooter on roadway (1)",
    "text": "Every person operating a bicycle, an electric bicycle or an electric scooter upon a roadway shall, except: (a) When traveling at a lawful rate of speed commensurate with the speed of any nearby traffic; (b) When preparing to turn left; or (c) When doing so would not be safe, ride as near to the right side of the roadway as practicable, exercising due care when passing a standing vehicle or one proceeding in the same direction. For purposes of paragraph (c) of subsection 1, the conditions under which it is not safe to operate a bicycle, an electric bicycle or an electric scooter as near to the right side of the roadway as practicable include, without limitation: (a) When fixed or moving objects, parked or moving vehicles, bicycles, pedestrians, animals or surface hazards impede access to the right side of the roadway. (b) When a lane is too narrow for a bicycle and a vehicle to travel safely side by side within the lane.",
    "source": "NRS 484B.777(1); with 484B.777(2)"
  },
  "summary": {
    "activation_conditions": [
      "the subject rides a bicycle, electric bicycle or electric scooter on a roadway"
    ],
    "exceptions": [
      "travelling at a lawful speed commensurate with nearby traffic",
      "preparing to turn left",
      "where riding near the right is not safe, including where objects, vehicles, riders, pedestrians, animals or surface hazards impede access to the right, or the lane is too narrow to share side by side"
    ],
    "id": "NRS-484B-777-1",
    "residue": [
      "'as practicable' and 'due care' are judgement elements: a lateral-offset bound and a clearance bound must be declared"
    ],
    "source": "NRS 484B.777(1); with 484B.777(2)",
