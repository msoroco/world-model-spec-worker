  "law": {
    "id": "NRS-484B-400-2c",
    "title": "Required position and method of turning at intersections (2)(c)",
    "text": "If the driver of a vehicle intends to turn at an intersection and: Both intersecting highways are two-directional: Except as otherwise directed by official traffic-control devices, simultaneous left turns by opposing traffic must be made in front of each other.",
    "source": "NRS 484B.400(2)(c)"
  },
  "summary": {
    "activation_conditions": [
      "the subject and an opposing vehicle turn left at the same intersection at the same time",
      "both intersecting highways are two-directional"
    ],
    "exceptions": [
      "where official traffic-control devices direct otherwise"
    ],
    "id": "NRS-484B-400-2c",
    "residue": [],
    "source": "NRS 484B.400(2)(c)",
    "subject": "driver",
    "theme": "turns_and_signals",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "span",
        "requirement": "'simultaneous' is a window over both vehicles' turns, so both paths must be in the trace"
      },
      {
        "kind": "continuous",
        "requirement": "the front-to-front geometry is judged throughout the crossing of the two paths"
      }
    ],
    "title": "Required position and method of turning at intersections (2)(c)"
  },
