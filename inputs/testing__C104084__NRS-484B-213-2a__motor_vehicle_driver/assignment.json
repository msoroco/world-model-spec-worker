  "law": {
    "id": "NRS-484B-213-2a",
    "title": "Limitations on overtaking on left side (2)(a)",
    "text": "A vehicle must not be driven to the left side of the highway at any time: When approaching the crest of a grade or upon a curve in the highway where the driver’s view is obstructed within such distance as to create a hazard in the event another vehicle might approach from the opposite direction. Subsection 2 does not apply upon a one-way highway.",
    "source": "NRS 484B.213(2)(a); with 484B.213(3)"
  },
