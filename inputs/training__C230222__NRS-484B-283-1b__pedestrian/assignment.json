  "law_record": {
    "id": "NRS-484B-283-1b",
    "title": "Right-of-way in crosswalk (1)(b)",
    "text": "Except as otherwise provided in NRS 484B.287 [NRS-484B-287-1c, NRS-484B-287-1d, NRS-484B-287-1e, LVMC-11-30-060-A, LVMC-11-30-060-B], 484B.290 [LVMC-11-30-140-B] and 484B.350 [LVMC-11-46-030]: A pedestrian shall not suddenly leave a curb or other place of safety and walk or run into the path of a vehicle which is so close that it is impossible for the driver to yield.",
    "source": "NRS 484B.283(1)(b)"
  },
  "summary": {
    "activation_conditions": [
      "the subject is a pedestrian at a curb or other place of safety",
      "a vehicle is approaching so closely that its driver could not yield"
    ],
    "exceptions": [],
    "id": "NRS-484B-283-1b",
    "residue": [
      "'suddenly' and 'impossible for the driver to yield' are judgement elements: a stopping-distance model must be declared"
    ],
    "source": "NRS 484B.283(1)(b)",
    "subject": "pedestrian",
    "theme": "pedestrian_duties",
    "tier": "Q",
    "timing_requirements": [
      {
        "kind": "point_event",
        "requirement": "the act is the entry into the path; the impossibility is judged from the vehicle's state at that instant"
      },
      {
        "kind": "span",
        "requirement": "the frames before the entry are needed to show the pedestrian was at a place of safety and left it suddenly"
      }
    ],
    "title": "Right-of-way in crosswalk (1)(b)"
  },
