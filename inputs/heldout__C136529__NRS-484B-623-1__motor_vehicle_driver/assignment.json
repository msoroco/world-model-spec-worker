  "law": {
    "id": "NRS-484B-623-1",
    "title": "Slow driving (1)",
    "text": "A person shall not drive a motor vehicle at such a slow speed as to impede the normal and reasonable movement of traffic except when reduced speed is necessary for safe operation or in compliance with law.",
    "source": "NRS 484B.623(1)"
  },
  "summary": {
    "activation_conditions": [
      "the subject drives a motor vehicle at a speed slow enough to impede the normal and reasonable movement of traffic"
    ],
    "exceptions": [
      "when the reduced speed is necessary for safe operation",
      "in compliance with law"
    ],
    "id": "NRS-484B-623-1",
    "residue": [
      "tier S: 'normal and reasonable movement' is the whole standard; the speed margin, the queue size and the duration are all surrogate parameters"
    ],
    "source": "NRS 484B.623(1)",
    "subject": "driver",
    "theme": "speed",
    "tier": "S",
    "timing_requirements": [
      {
        "kind": "duration",
        "requirement": "impeding is not instantaneous: a duration for which the slow speed and the queue must persist has to be declared"
      },
      {
        "kind": "continuous",
        "requirement": "judged while both the slow speed and the impeded traffic hold"
      }
    ],
    "title": "Slow driving (1)"
  },
