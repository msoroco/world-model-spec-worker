  "law": {
    "id": "NRS-484B-250-2",
    "title": "Vehicle approaching or entering intersection (2)",
    "text": "When two vehicles enter an intersection from different highways at approximately the same time, the driver of the vehicle on the left shall yield the right-of-way to the vehicle on the right. Except as otherwise provided in subsection 4 [NRS-484B-250-4], this section does not apply at intersections controlled by official traffic-control devices or to vehicles approaching each other from opposite directions, when the driver of one of the vehicles is intending to or is making a left turn.",
    "source": "NRS 484B.250(2); with 484B.250(5)"
  },
  "summary": {
    "activation_conditions": [
      "two vehicles enter the intersection from different highways at approximately the same time",
      "the intersection is uncontrolled",
      "the subject is the one on the left"
    ],
    "exceptions": [
      "intersections controlled by official traffic-control devices, unless the signal is inoperative",
      "vehicles approaching from opposite directions where one is making or intending a left turn"
    ],
    "id": "NRS-484B-250-2",
    "residue": [],
    "source": "NRS 484B.250(2); with 484B.250(5)",
    "subject": "driver",
    "theme": "intersections_and_right_of_way",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "ordering",
        "requirement": "'approximately the same time' is a simultaneity window: the tolerance on arrival order must be declared"
      },
      {
        "kind": "point_event",
        "requirement": "the test is at the entries; a later overtake in the intersection is a different matter"
      }
    ],
    "title": "Vehicle approaching or entering intersection (2)"
  },
