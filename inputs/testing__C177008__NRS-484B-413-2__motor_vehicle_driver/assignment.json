  "law": {
    "id": "NRS-484B-413-2",
    "title": "Requirements for turning on highway (2)",
    "text": "A signal of intention to turn right or left, or otherwise turn a vehicle from a direct course, shall be given continuously during not less than the last 100 feet traveled in a business or residential district and not less than the last 300 feet traveled in any other area prior to changing the course of a vehicle. This rule shall be observed, regardless of the weather.",
    "source": "NRS 484B.413(2)"
  },
  "summary": {
    "activation_conditions": [
      "the subject is about to turn right or left, or otherwise change course"
    ],
    "exceptions": [
      "none — the rule states expressly that it is observed regardless of the weather"
    ],
    "id": "NRS-484B-413-2",
    "residue": [
      "'business or residential district' is a legal region class: a reading assumption that selects which of the two distances applies"
    ],
    "source": "NRS 484B.413(2)",
    "subject": "driver",
    "theme": "turns_and_signals",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "advance",
        "requirement": "the signal must run continuously over the last 100 feet before the change in a business or residential district, and over the last 300 feet elsewhere"
      },
      {
        "kind": "continuous",
        "requirement": "'continuously' — a signal switched on and off inside the distance does not satisfy the rule"
      },
      {
        "kind": "span",
        "requirement": "the trace must cover at least the last 300 feet of approach for the longer case to be decidable"
      }
    ],
    "title": "Requirements for turning on highway (2)"
  },
