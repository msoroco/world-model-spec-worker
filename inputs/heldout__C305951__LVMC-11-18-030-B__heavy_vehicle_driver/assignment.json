  "law": {
    "id": "LVMC-11-18-030-B",
    "title": "Traffic lanes (B)",
    "text": "Where such traffic lanes have been marked, it shall be unlawful for the operator of any vehicle to fail or refuse to keep such vehicle within the boundaries of any such lane except when lawfully passing another vehicle or preparatory to making a lawful turning movement.",
    "source": "LVMC 11.18.030(B)"
  },
  "summary": {
    "activation_conditions": [
      "traffic lanes have been marked",
      "the subject fails to keep the vehicle within the boundaries of its lane"
    ],
    "exceptions": [
      "when lawfully passing another vehicle",
      "preparatory to making a lawful turning movement"
    ],
    "id": "LVMC-11-18-030-B",
    "residue": [
      "'lawfully passing' and 'lawful turning movement' are references to other rules — rule composition"
    ],
    "source": "LVMC 11.18.030(B)",
    "subject": "driver",
    "theme": "lanes",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "continuous",
        "requirement": "judged at every instant; a straddle that is not covered by an exception is the violation"
      },
      {
        "kind": "duration",
        "requirement": "a lane change necessarily straddles, so a tolerance for a signalled, completed change must be declared"
      }
    ],
    "title": "Traffic lanes (B)"
  },
