  "law_record": {
    "id": "NRS-484B-307-2b",
    "title": "Traffic controlled by official traffic-control devices (2)(b)",
    "text": "When the signal is circular green alone: Pedestrians facing such a signal may proceed across the highway within any marked or unmarked crosswalk, unless directed otherwise by another device as provided in NRS 484B.283 [NRS-484B-283-1d1, NRS-484B-283-1d2, NRS-484B-283-1d3, NRS-484B-283-1d4].",
    "source": "NRS 484B.307(2)(b)"
  },
  "summary": {
    "activation_conditions": [
      "the signal facing the pedestrian shows circular green alone",
      "the pedestrian crosses within a marked or unmarked crosswalk"
    ],
    "exceptions": [
      "where a pedestrian signal directs otherwise, the pedestrian-signal rules govern"
    ],
    "id": "NRS-484B-307-2b",
    "residue": [
      "this line is a permission, so a violation can only be of the rules it defers to"
    ],
    "source": "NRS 484B.307(2)(b)",
