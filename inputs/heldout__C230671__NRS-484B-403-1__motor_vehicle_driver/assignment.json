  "law": {
    "id": "NRS-484B-403-1",
    "title": "When U-turns are authorized and prohibited (1)",
    "text": "A U-turn may be made on any road where the turn can be made with safety, except as prohibited by this section [NRS-484B-403-2, NRS-484B-403-3] and by the provisions of NRS 484B.227, 484B.363 and 484B.407 [NRS-484B-227-1, NRS-484B-363-3, NRS-484B-407].",
    "source": "NRS 484B.403(1)"
  },
