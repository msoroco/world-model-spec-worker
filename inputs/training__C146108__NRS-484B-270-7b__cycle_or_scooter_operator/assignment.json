  "law_record": {
    "id": "NRS-484B-270-7b",
    "title": "Vehicles, bicycles, electric bicycles, electric scooters and pedestrians (7)(b)",
    "text": "The operator of a bicycle, an electric bicycle or an electric scooter shall not: Overtake and pass a motor vehicle unless the operator can do so safely without endangering himself or herself or the occupants of the motor vehicle.",
    "source": "NRS 484B.270(7)(b)"
  },
