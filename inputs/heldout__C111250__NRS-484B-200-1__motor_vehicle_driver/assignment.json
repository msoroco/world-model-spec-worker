  "law": {
    "id": "NRS-484B-200-1",
    "title": "Driving on right half of highway required (1)",
    "text": "Upon all highways of sufficient width a vehicle must be driven upon the right half of the highway, except as follows: (a) When overtaking and passing another vehicle proceeding in the same direction under the laws governing such movements; (b) When the right half of the highway is closed to traffic; (c) Upon a highway divided into three lanes for traffic under the laws applicable thereon; (d) Upon a highway designated and posted for one-way traffic; or (e) When the highway is not of sufficient width.",
    "source": "NRS 484B.200(1)"
  },
  "summary": {
    "activation_conditions": [
      "the subject is driven on a highway of sufficient width for two lines of traffic",
      "the highway is not posted one-way"
    ],
    "exceptions": [
      "overtaking and passing a vehicle going the same way, under the rules governing that movement",
      "the right half is closed to traffic",
      "a highway divided into three lanes, under the rules for that layout",
      "a highway designated and posted for one-way traffic",
      "the highway is not of sufficient width"
    ],
    "id": "NRS-484B-200-1",
    "residue": [
      "'sufficient width' is a judgement about the road, resolvable from st.lane_width plus a declared vehicle width"
    ],
    "source": "NRS 484B.200(1)",
    "subject": "driver",
    "theme": "roadway_position",
    "tier": "Q",
    "timing_requirements": [
      {
        "kind": "continuous",
        "requirement": "the duty holds at every instant; each frame in the left half must be covered by an exception"
      },
      {
        "kind": "duration",
        "requirement": "an overtaking excursion is excepted only for its duration — the return is governed by the overtaking rules the text cites"
      }
    ],
    "title": "Driving on right half of highway required (1)"
  },
