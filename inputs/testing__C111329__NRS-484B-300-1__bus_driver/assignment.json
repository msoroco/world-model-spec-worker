  "law": {
    "id": "NRS-484B-300-1",
    "title": "Obedience to devices for control of traffic (1)",
    "text": "Except as otherwise provided in NRS 484B.307 [NRS-484B-307-2a, NRS-484B-307-2b, NRS-484B-307-3a, NRS-484B-307-4a, NRS-484B-307-4b, NRS-484B-307-5a, NRS-484B-307-6a, NRS-484B-307-7a, NRS-484B-307-8a, NRS-484B-307-8b, NRS-484B-307-8c, NRS-484B-307-8d, NRS-484B-307-8e, NRS-484B-307-9a, NRS-484B-307-9b, NRS-484B-307-9c, NRS-484B-307-11, NRS-484B-307-12a, NRS-484B-307-12b], it is unlawful for any driver to disobey the instructions of any official traffic-control device placed in accordance with the provisions of chapters 484A to 484E, inclusive, of NRS, unless at the time otherwise directed by a police officer.",
    "source": "NRS 484B.300(1)"
  },
