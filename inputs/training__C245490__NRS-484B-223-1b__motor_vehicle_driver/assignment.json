  "law_record": {
    "id": "NRS-484B-223-1b",
    "title": "Driving on highway having multiple marked lanes for traffic (1)(b)",
    "text": "If a highway has two or more clearly marked lanes for traffic traveling in one direction, vehicles must: Not be moved from that lane until the driver has given the appropriate turn signal and ascertained that such movement can be made with safety.",
    "source": "NRS 484B.223(1)(b)"
  },
  "summary": {
    "activation_conditions": [
      "the highway has two or more clearly marked lanes in the subject's direction",
      "the subject moves out of its lane"
    ],
    "exceptions": [],
    "id": "NRS-484B-223-1b",
    "residue": [
      "'ascertained … with safety' is a judgement element about the driver's check; the observable substitute is the gap the target lane offered"
    ],
    "source": "NRS 484B.223(1)(b)",
    "subject": "driver",
    "theme": "lanes",
    "tier": "Q",
