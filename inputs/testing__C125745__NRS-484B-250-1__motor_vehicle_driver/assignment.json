  "law": {
    "id": "NRS-484B-250-1",
    "title": "Vehicle approaching or entering intersection (1)",
    "text": "The driver of a vehicle approaching an intersection shall yield the right-of-way to a vehicle which has entered the intersection from a different highway. Except as otherwise provided in subsection 4 [NRS-484B-250-4], this section does not apply at intersections controlled by official traffic-control devices or to vehicles approaching each other from opposite directions, when the driver of one of the vehicles is intending to or is making a left turn.",
    "source": "NRS 484B.250(1); with 484B.250(5)"
  },
  "summary": {
    "activation_conditions": [
      "the subject is approaching an intersection",
      "another vehicle has already entered the intersection from a different highway",
      "the intersection is not controlled by official traffic-control devices"
    ],
    "exceptions": [
      "intersections controlled by official traffic-control devices, unless the signal is inoperative (the subsection-4 case)",
      "vehicles approaching from opposite directions where one is making or intending a left turn"
    ],
    "id": "NRS-484B-250-1",
    "residue": [],
    "source": "NRS 484B.250(1); with 484B.250(5)",
    "subject": "driver",
    "theme": "intersections_and_right_of_way",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "ordering",
        "requirement": "the other vehicle's entry precedes the subject's; that order is the whole test"
      },
      {
        "kind": "continuous",
        "requirement": "the duty lasts while the other vehicle is in the intersection"
      }
    ],
    "title": "Vehicle approaching or entering intersection (1)"
  },
