  "law_record": {
    "id": "NRS-486-351-1",
    "title": "Unlawful passing (1)",
    "text": "A person, except a police officer in the performance of his or her duty, shall not drive a motorcycle or moped between moving or stationary vehicles occupying adjacent traffic lanes.",
    "source": "NRS 486.351(1)"
  },
