  "law_record": {
    "id": "NRS-484B-253",
    "title": "Vehicle turning left",
    "text": "The driver of a vehicle within an intersection intending to turn to the left shall yield the right-of-way to any vehicle approaching from the opposite direction which is within the intersection or so close thereto as to constitute an immediate hazard, but such driver, having so yielded and having given a signal when and as required, may make such left turn and the drivers of all other vehicles approaching the intersection from the opposite direction shall yield the right-of-way to the vehicle making the left turn.",
    "source": "NRS 484B.253"
  },
  "summary": {
    "activation_conditions": [
      "the subject is within an intersection intending to turn left",
      "a vehicle approaches from the opposite direction, within the intersection or so close as to be an immediate hazard"
    ],
    "exceptions": [
      "once the subject has yielded and signalled as required, the turn may be made and the oncoming drivers then owe the yield"
    ],
    "id": "NRS-484B-253",
    "residue": [
      "'immediate hazard' is a judgement element: the time-to-conflict bound must be declared"
    ],
    "source": "NRS 484B.253",
    "subject": "driver",
    "theme": "intersections_and_right_of_way",
    "tier": "Q",
    "timing_requirements": [
      {
        "kind": "ordering",
        "requirement": "yield first, then turn; the duty ends when the hazard has passed"
      },
      {
        "kind": "advance",
        "requirement": "the signal must have been given 'when and as required' — the advance distance comes from the turn-signal rule"
      },
      {
        "kind": "continuous",
        "requirement": "the hazard test is re-evaluated while the subject waits"
      }
    ],
    "title": "Vehicle turning left"
  },
