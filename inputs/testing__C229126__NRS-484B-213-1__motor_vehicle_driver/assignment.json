  "law": {
    "id": "NRS-484B-213-1",
    "title": "Limitations on overtaking on left side (1)",
    "text": "A vehicle must not be driven to the left side of the center of a two-lane, two-directional highway and overtaking and passing another vehicle proceeding in the same direction, unless such left side is clearly visible and is free of oncoming traffic for a sufficient distance ahead to permit such overtaking and passing to be completely made without interfering with the safe operation of any vehicle approaching from the opposite direction or any vehicle overtaken.",
    "source": "NRS 484B.213(1)"
  },
