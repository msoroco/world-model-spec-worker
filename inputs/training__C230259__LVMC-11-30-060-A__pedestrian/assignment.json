  "law_record": {
    "id": "LVMC-11-30-060-A",
    "title": "Crossing outside crosswalk (A)",
    "text": "Every pedestrian crossing a roadway at any point other than within a marked crosswalk or within an unmarked crosswalk at an intersection shall yield the right-of-way to all vehicles upon the roadway. The foregoing rules in this Section shall have no application under the conditions stated in Section 11.30.070 when pedestrians are prohibited from crossing at certain designated places.",
    "source": "LVMC 11.30.060(A); with 11.30.060(C)"
  },
  "summary": {
    "activation_conditions": [
      "the subject is a pedestrian crossing a roadway at a point other than within a marked crosswalk or an unmarked crosswalk at an intersection",
      "vehicles are upon the roadway"
    ],
    "exceptions": [
      "the rule does not apply where pedestrians are prohibited from crossing at designated places under the cited section"
    ],
    "id": "LVMC-11-30-060-A",
    "residue": [],
