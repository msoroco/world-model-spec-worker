  "law_record": {
    "id": "NRS-484B-400-2a",
    "title": "Required position and method of turning at intersections (2)(a)",
    "text": "If the driver of a vehicle intends to turn at an intersection and: Both intersecting highways are two-directional: The approach for a left turn must be made in that portion of the right half of the highway nearest the centerline thereof.",
    "source": "NRS 484B.400(2)(a)"
  },
