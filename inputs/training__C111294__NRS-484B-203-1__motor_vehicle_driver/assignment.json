  "law_record": {
    "id": "NRS-484B-203-1",
    "title": "Duties of drivers passing vehicles proceeding in opposite directions (1)",
    "text": "Drivers of vehicles proceeding in opposite directions shall pass each other keeping to the right, and upon highways having width for not more than one line of traffic in each direction, each driver shall give to the other at least one-half of the paved portion of the highway as nearly as possible.",
    "source": "NRS 484B.203(1)"
  },
  "summary": {
    "activation_conditions": [
      "the subject meets a vehicle proceeding in the opposite direction",
      "on a road with width for not more than one line of traffic in each direction, the second duty also applies"
    ],
    "exceptions": [],
    "id": "NRS-484B-203-1",
    "residue": [
      "'as nearly as possible' is a judgement element bounding the lateral offset"
    ],
    "source": "NRS 484B.203(1)",
    "subject": "driver",
    "theme": "roadway_position",
    "tier": "Q",
    "timing_requirements": [
      {
        "kind": "point_event",
        "requirement": "judged at the meeting — the frames in which the two bodies are abreast"
      },
      {
        "kind": "continuous",
        "requirement": "the approach to the meeting matters too: the half must be given up before the vehicles are abreast, not at the last instant"
      }
    ],
    "title": "Duties of drivers passing vehicles proceeding in opposite directions (1)"
  },
