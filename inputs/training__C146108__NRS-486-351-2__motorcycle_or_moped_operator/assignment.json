  "law_record": {
    "id": "NRS-486-351-2",
    "title": "Unlawful passing (2)",
    "text": "Except as provided in subsection 3, a person shall not drive a motorcycle, moped or trimobile abreast of or overtake or pass another vehicle within the same traffic lane. Motorcycles and mopeds may, with the consent of the drivers, be operated no more than two abreast in a single traffic lane.",
    "source": "NRS 486.351(2); with 486.351(3)"
  },
  "summary": {
    "activation_conditions": [
      "the subject rides a motorcycle, moped or trimobile",
      "another vehicle occupies the same traffic lane",
      "the subject draws abreast of it, overtakes or passes it within that lane"
    ],
    "exceptions": [
      "two motorcycles or mopeds may be operated two abreast in a single lane with the consent of their drivers",
      "the further exception the section's subsection 3 gives"
    ],
    "id": "NRS-486-351-2",
    "residue": [
      "the consent of the two riders is not observable; two machines riding abreast is the observable state"
    ],
    "source": "NRS 486.351(2); with 486.351(3)",
    "subject": "motorcyclist",
    "theme": "motorcycles",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "continuous",
        "requirement": "judged while both occupy the same lane"
      },
      {
        "kind": "span",
        "requirement": "an overtake within the lane is an episode; the pass must be visible from behind to ahead"
      }
    ],
    "title": "Unlawful passing (2)"
  },
