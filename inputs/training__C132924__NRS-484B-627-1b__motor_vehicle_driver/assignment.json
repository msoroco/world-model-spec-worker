  "law_record": {
    "id": "NRS-484B-627-1b",
    "title": "Duties of driver or operator driving or operating motor vehicle at speed so slow as to impede forward movement of traffic (1)(b)",
    "text": "If any driver or operator of a motor vehicle drives or operates a motor vehicle at a speed so slow as to impede the forward movement of traffic proceeding immediately behind the driver or operator, the driver or operator shall: If the highway has two or more clearly marked lanes for traffic traveling in the direction in which the driver or operator is traveling, drive in the extreme right-hand lane except when necessary to pass other slowly moving vehicles.",
    "source": "NRS 484B.627(1)(b)"
  },
  "summary": {
    "activation_conditions": [
      "the subject drives so slowly as to impede the traffic immediately behind",
      "the highway has two or more clearly marked lanes in the subject's direction"
    ],
    "exceptions": [
      "when necessary to pass other slowly moving vehicles"
    ],
    "id": "NRS-484B-627-1b",
    "residue": [
      "'impede' is a judgement element"
    ],
    "source": "NRS 484B.627(1)(b)",
    "subject": "driver",
    "theme": "speed",
    "tier": "Q",
    "timing_requirements": [
      {
        "kind": "continuous",
        "requirement": "the extreme right lane must be held while the impeding condition lasts"
      },
      {
        "kind": "duration",
        "requirement": "a pass of a slower vehicle is excepted only for its duration"
      }
    ],
