  "law_record": {
    "id": "NRS-484B-627-2",
    "title": "Duties of driver or operator driving or operating motor vehicle at speed so slow as to impede forward movement of traffic (2)",
    "text": "A person shall not bring a vehicle to a complete stop upon a roadway so as to impede or block the normal and reasonable movement of traffic unless the stop is necessary for safe operation or in compliance with law.",
    "source": "NRS 484B.627(2)"
  },
  "summary": {
    "activation_conditions": [
      "the subject brings the vehicle to a complete stop on a roadway",
      "the stop impedes or blocks the normal and reasonable movement of traffic"
    ],
    "exceptions": [
      "the stop is necessary for safe operation",
      "the stop is in compliance with law"
    ],
    "id": "NRS-484B-627-2",
    "residue": [
      "tier S: 'normal and reasonable movement' is the whole standard"
    ],
    "source": "NRS 484B.627(2)",
    "subject": "driver",
    "theme": "speed",
    "tier": "S",
    "timing_requirements": [
