  "law_record": {
    "id": "LVMC-11-40-120",
    "title": "Use of available path",
    "text": "Whenever a usable path for bicycles, electric bicycles, or electric scooters has been provided adjacent to a roadway, riders of bicycles, electric bicycles, and electric scooters shall use such path and shall not use the roadway.",
    "source": "LVMC 11.40.120"
  },
  "summary": {
    "activation_conditions": [
      "a usable path for such machines is provided adjacent to the roadway",
      "the subject rides on the roadway instead"
    ],
    "exceptions": [
      "where the path is not usable"
    ],
    "id": "LVMC-11-40-120",
    "residue": [
      "'usable' is a judgement element about the path's condition",
      "this municipal duty is narrower than the state rules on where a rider may ride; a reading must say how they compose"
    ],
    "source": "LVMC 11.40.120",
    "subject": "rider",
    "theme": "cycles_and_devices",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "continuous",
        "requirement": "judged at every instant the rider is on the roadway beside a usable path"
      }
    ],
    "title": "Use of available path"
