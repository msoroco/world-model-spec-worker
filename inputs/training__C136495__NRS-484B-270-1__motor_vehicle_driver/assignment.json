  "law_record": {
    "id": "NRS-484B-270-1",
    "title": "Vehicles, bicycles, electric bicycles, electric scooters and pedestrians (1)",
    "text": "The driver of a motor vehicle shall not intentionally interfere with the movement of a person lawfully riding a bicycle, an electric bicycle or an electric scooter.",
    "source": "NRS 484B.270(1)"
  },
  "summary": {
    "activation_conditions": [
      "a person is lawfully riding a bicycle, electric bicycle or electric scooter",
      "the subject is the driver of a motor vehicle near that rider"
    ],
    "exceptions": [],
    "id": "NRS-484B-270-1",
    "residue": [
      "tier S and 'intentionally': intent is interior state, so any rule is a surrogate",
      "'lawfully riding' is a reference to the rider's own rules — rule composition, not an atom"
    ],
    "source": "NRS 484B.270(1)",
    "subject": "driver",
    "theme": "vulnerable_road_users",
    "tier": "S",
    "timing_requirements": [
      {
        "kind": "continuous",
        "requirement": "judged whenever the subject and the rider share a conflict"
      },
      {
        "kind": "ordering",
        "requirement": "the rider's evasive action must follow the subject's movement for the interference to be attributable"
      }
    ],
    "title": "Vehicles, bicycles, electric bicycles, electric scooters and pedestrians (1)"
  },
