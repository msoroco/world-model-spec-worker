  "law": {
    "id": "NRS-484B-600-1c",
    "title": "Basic rule (1)(c)",
    "text": "It is unlawful for any person to drive or operate a vehicle of any kind or character at: A rate of speed greater than that posted by a public authority for the particular portion of highway being traversed.",
    "source": "NRS 484B.600(1)(c)"
  },
  "summary": {
