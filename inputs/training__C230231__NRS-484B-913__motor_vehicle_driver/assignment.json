  "law_record": {
    "id": "NRS-484B-913",
    "title": "Crossing fire hose",
    "text": "A vehicle shall not be driven over any unprotected hose of a fire department when laid down on any highway or private way or place for use at any fire or alarm of fire or practice runs, without the consent of the fire department official in command.",
    "source": "NRS 484B.913"
  },
  "summary": {
    "activation_conditions": [
      "an unprotected fire department hose is laid on a highway, private way or place",
      "the subject drives over it"
    ],
    "exceptions": [
      "with the consent of the fire department official in command"
    ],
    "id": "NRS-484B-913",
    "residue": [
      "consent is a communication, not a scene fact; at best an officer's gesture is observable",
      "whether the hose is 'unprotected' depends on a ramp or cover being absent"
    ],
    "source": "NRS 484B.913",
