  "law_record": {
    "id": "LVMC-11-52-300",
    "title": "Nighttime and nonmotor vehicles",
    "text": "Except for a motor vehicle, no person shall park any vehicle on any street for a period of time longer than thirty minutes between the hours of one a.m. and six a.m. of any day.",
    "source": "LVMC 11.52.300"
  },
  "summary": {
    "activation_conditions": [
      "the vehicle is not a motor vehicle",
      "it is parked on a street",
      "the time is between one a.m. and six a.m."
    ],
    "exceptions": [
      "a motor vehicle is outside the rule entirely"
    ],
    "id": "LVMC-11-52-300",
    "residue": [],
    "source": "LVMC 11.52.300",
    "subject": "any_person",
    "theme": "stopping_standing_parking",
