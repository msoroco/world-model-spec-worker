  "law": {
    "id": "NRS-484B-250-3",
    "title": "Vehicle approaching or entering intersection (3)",
    "text": "When two vehicles enter an intersection at approximately the same time, one vehicle traveling on a highway which ends at the intersection and the other vehicle traveling on a through highway, the driver of the vehicle on the highway which ends at the intersection shall yield the right-of-way to the other vehicle. Except as otherwise provided in subsection 4 [NRS-484B-250-4], this section does not apply at intersections controlled by official traffic-control devices or to vehicles approaching each other from opposite directions, when the driver of one of the vehicles is intending to or is making a left turn.",
    "source": "NRS 484B.250(3); with 484B.250(5)"
  },
  "summary": {
    "activation_conditions": [
      "two vehicles enter the intersection at approximately the same time",
      "one travels on a highway that ends at the intersection, the other on a through highway",
      "the intersection is uncontrolled"
    ],
    "exceptions": [
      "intersections controlled by official traffic-control devices, unless the signal is inoperative",
      "vehicles approaching from opposite directions where one is making or intending a left turn"
    ],
    "id": "NRS-484B-250-3",
    "residue": [
      "whether the highway 'ends at the intersection' is a concept over the lane graph (st.lane_enters with st.lane_connectivity), available where the source's road graph carries lane successors"
    ],
    "source": "NRS 484B.250(3); with 484B.250(5)",
    "subject": "driver",
    "theme": "intersections_and_right_of_way",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "ordering",
        "requirement": "arrival order within the simultaneity tolerance"
      },
      {
        "kind": "continuous",
        "requirement": "the yield holds until the through vehicle has cleared the conflict"
      }
    ],
    "title": "Vehicle approaching or entering intersection (3)"
  },
