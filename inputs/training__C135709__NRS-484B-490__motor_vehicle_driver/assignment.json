  "law_record": {
    "id": "NRS-484B-490",
    "title": "Parking on narrow highway",
    "text": "When official traffic-control devices are erected prohibiting parking upon a narrow highway, a person shall not park a vehicle upon any such highway.",
    "source": "NRS 484B.490"
  },
