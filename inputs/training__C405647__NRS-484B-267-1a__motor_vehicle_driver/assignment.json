  "law_record": {
    "id": "NRS-484B-267-1a",
    "title": "Operation of vehicle on approach of authorized emergency vehicle or official vehicle of regulatory agency (1)(a)",
    "text": "Upon the immediate approach of an authorized emergency vehicle or an official vehicle of a regulatory agency, making use of flashing lights meeting the requirements of subsection 3 of NRS 484A.480 [DEF-NRS-484A-480-3], the driver of every other vehicle shall, except when otherwise directed by a law enforcement officer: Yield the right-of-way.",
    "source": "NRS 484B.267(1)(a)"
  },
  "summary": {
    "activation_conditions": [
      "an authorized emergency vehicle or regulatory-agency official vehicle is on immediate approach",
      "it is using flashing lights of the required kind",
      "the subject is the driver of another vehicle"
    ],
    "exceptions": [
      "when otherwise directed by a law enforcement officer"
    ],
    "id": "NRS-484B-267-1a",
    "residue": [
      "'immediate approach' bounds the distance or time at which the duty starts and must be declared",
      "whether the lamps meet the statutory specification is an equipment fact; the observable is a flashing red or blue lamp"
    ],
    "source": "NRS 484B.267(1)(a)",
    "subject": "driver",
    "theme": "emergency_and_incident",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "ordering",
        "requirement": "the lamps and the approach precede the duty; the yield is owed from the moment the approach is immediate"
      },
      {
        "kind": "continuous",
        "requirement": "the duty holds throughout the approach"
      }
    ],
    "title": "Operation of vehicle on approach of authorized emergency vehicle or official vehicle of regulatory agency (1)(a)"
  },
