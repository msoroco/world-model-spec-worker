  "law_record": {
    "id": "NRS-484B-413-3",
    "title": "Requirements for turning on highway (3)",
    "text": "A driver shall not stop or suddenly decrease the speed of a vehicle without first giving an appropriate signal to the driver of any vehicle immediately to the rear.",
    "source": "NRS 484B.413(3)"
  },
  "summary": {
    "activation_conditions": [
      "the subject stops or suddenly decreases speed",
      "a vehicle is immediately to the rear"
    ],
    "exceptions": [],
    "id": "NRS-484B-413-3",
    "residue": [
      "'suddenly' is a judgement element: a deceleration bound must be declared",
      "a brake lamp is an actuation, not the deceleration: the rule reads both"
    ],
    "source": "NRS 484B.413(3)",
    "subject": "driver",
    "theme": "turns_and_signals",
    "tier": "Q",
    "timing_requirements": [
      {
        "kind": "ordering",
        "requirement": "'without first giving' — the signal must precede the stop or the deceleration"
      },
      {
        "kind": "advance",
        "requirement": "a lead time for the signal must be declared; the text gives no distance for this case"
      }
    ],
    "title": "Requirements for turning on highway (3)"
  },
