  "law_record": {
    "id": "LVMC-11-48-060",
    "title": "Streets between",
    "text": "Streets, other than truck routes, shall not be used as through routes from one truck route to another unless pick-up, delivery or essential use is required enroute.",
    "source": "LVMC 11.48.060"
  },
  "summary": {
    "activation_conditions": [
      "the subject drives a truck from one truck route to another over a street that is not a truck route",
      "no pick-up, delivery or essential use is required en route"
    ],
    "exceptions": [
      "where pick-up, delivery or essential use is required en route"
    ],
    "id": "LVMC-11-48-060",
    "residue": [
      "'essential use' is a purpose; the observable evidence is a stop at premises along the way"
    ],
    "source": "LVMC 11.48.060",
    "subject": "truck_driver",
    "theme": "truck_routes",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "span",
        "requirement": "a through route is a journey-level fact: the trace must cover the whole passage between the two truck routes"
      },
      {
        "kind": "duration",
        "requirement": "a stop long enough for a delivery is what distinguishes the excepted trip; the bound must be declared"
      }
    ],
    "title": "Streets between"
