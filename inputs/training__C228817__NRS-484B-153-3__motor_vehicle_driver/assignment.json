  "law_record": {
    "id": "NRS-484B-153-3",
    "title": "Boarding or alighting from vehicle (3)",
    "text": "A person shall not leave open a door on the side of a vehicle which is closest to passing traffic longer than is necessary for immediate loading or unloading of passengers or cargo.",
    "source": "NRS 484B.153(3)"
  },
  "summary": {
    "activation_conditions": [
      "a door on the traffic side of the vehicle is open"
    ],
    "exceptions": [
      "the time necessary for immediate loading or unloading of passengers or cargo"
    ],
    "id": "NRS-484B-153-3",
    "residue": [
      "'longer than is necessary for immediate loading or unloading' is a purpose-and-necessity judgement; the observable evidence is the duration and whether a person or cargo actually moved"
    ],
    "source": "NRS 484B.153(3)",
    "subject": "occupant",
    "theme": "doors_and_boarding",
    "tier": "Q",
    "timing_requirements": [
      {
        "kind": "duration",
        "requirement": "the offence is the excess of the open interval over what immediate loading needs: a duration bound must be declared and the open interval measured against it"
      },
      {
        "kind": "continuous",
        "requirement": "the door state must be tracked across frames — a single frame of an open door decides nothing"
      }
    ],
    "title": "Boarding or alighting from vehicle (3)"
  },
