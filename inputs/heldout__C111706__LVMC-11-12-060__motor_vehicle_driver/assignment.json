  "law": {
    "id": "LVMC-11-12-060",
    "title": "Turning around—Fire stations",
    "text": "No vehicle in front of the driveway, entrance or approaches to a fire station shall be turned so as to proceed in the opposite direction. No vehicle shall use the driveway entrance or approaches to a fire station for the purpose of turning so as to proceed in the opposite direction.",
    "source": "LVMC 11.12.060"
  },
  "summary": {
    "activation_conditions": [
      "the subject turns to proceed in the opposite direction in front of a fire station driveway, entrance or approach, or uses that driveway to turn"
    ],
    "exceptions": [],
    "id": "LVMC-11-12-060",
    "residue": [
      "'for the purpose of turning' is purpose; the completed reversal is the observable evidence"
    ],
    "source": "LVMC 11.12.060",
    "subject": "driver",
    "theme": "turns_and_signals",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "span",
        "requirement": "a three-point turn through the driveway is an episode; entry, reversal and exit are all needed"
      },
      {
        "kind": "point_event",
        "requirement": "the reversal in front of the entrance is judged where it occurs"
      }
    ],
    "title": "Turning around—Fire stations"
  },
