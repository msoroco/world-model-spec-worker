  "law_record": {
    "id": "NRS-484B-450-1m",
    "title": "Stopping, standing or parking prohibited in specified places (1)(m)",
    "text": "A person shall not stop, stand or park a vehicle, except when necessary to avoid conflict with other traffic or in compliance with law or the directions of a police officer or official traffic-control device, in any of the following places: Upon any bridge or other elevated structure or within a highway tunnel.",
    "source": "NRS 484B.450(1)(m)"
  },
