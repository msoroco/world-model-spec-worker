  "law": {
    "id": "LVMC-11-42-030",
    "title": "Reversible lanes—Temporary designation",
    "text": "The City Traffic Engineer is authorized to determine and designate streets, or specific lanes thereon upon which vehicular traffic shall proceed in one direction during one period and the opposite direction during another period of the day, and may also erect signs temporarily designating lanes to be used by traffic moving in any particular direction, regardless of the centerline of the roadway. It shall be unlawful for any person to operate any vehicle in violation of such markings, signs, barriers, or other devices so placed in accordance with this Section.",
    "source": "LVMC 11.42.030"
  },
  "summary": {
    "activation_conditions": [
      "markings, signs, barriers or other devices designate the direction of travel for the street or lane for the current period",
      "the subject operates a vehicle in violation of them"
    ],
    "exceptions": [],
    "id": "LVMC-11-42-030",
    "residue": [
      "the centreline is expressly irrelevant here, so a rule that infers direction from the centreline rather than from the devices reads the road wrongly"
    ],
    "source": "LVMC 11.42.030",
    "subject": "driver",
    "theme": "lanes",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "continuous",
        "requirement": "judged at every instant in the designated lane"
      },
      {
        "kind": "civil_time",
        "requirement": "the designation is period-dependent: the same lane is lawful in one direction at one time of day and the other at another, so the time must be read"
      }
    ],
    "title": "Reversible lanes—Temporary designation"
  },
  "summary_status": "provided_planning_context_full_text_remains_authoritative",
