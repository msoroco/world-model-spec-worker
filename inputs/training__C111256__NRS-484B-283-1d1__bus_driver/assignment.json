  "law_record": {
    "id": "NRS-484B-283-1d1",
    "title": "Right-of-way in crosswalk (1)(d)(1)",
    "text": "Except as otherwise provided in NRS 484B.287 [NRS-484B-287-1c, NRS-484B-287-1d, NRS-484B-287-1e, LVMC-11-30-060-A, LVMC-11-30-060-B], 484B.290 [LVMC-11-30-140-B] and 484B.350 [LVMC-11-46-030]: Whenever signals exhibiting the words “Walk,” “Don’t Walk,” “Wait” or similar symbols are in place, such signals indicate as follows: While the “Walk” indication or walking person symbol is illuminated, pedestrians facing the signal may proceed across the highway in the direction of the signal and must be given the right-of-way by the drivers of all vehicles.",
    "source": "NRS 484B.283(1)(d)(1)"
  },
  "summary": {
    "activation_conditions": [
      "a pedestrian signal is in place at the crossing",
      "its walk indication is illuminated",
      "a pedestrian facing it is proceeding across"
    ],
    "exceptions": [],
    "id": "NRS-484B-283-1d1",
    "residue": [],
    "source": "NRS 484B.283(1)(d)(1)",
    "subject": "driver",
    "theme": "vulnerable_road_users",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "continuous",
        "requirement": "the right-of-way holds while the walk indication is shown and the pedestrian is crossing"
      },
      {
        "kind": "ordering",
        "requirement": "the pedestrian's crossing precedes the driver's passage through the same part of the crosswalk"
      }
    ],
    "title": "Right-of-way in crosswalk (1)(d)(1)"
  },
