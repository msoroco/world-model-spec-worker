  "law": {
    "id": "NRS-484D-205-4",
    "title": "Additional equipment for lighting (4)",
    "text": "Any motor vehicle may be equipped with one or more backup lamps either separately or in combination with other lamps. Backup lamps shall not be lighted when the vehicle is in forward motion.",
    "source": "NRS 484D.205(4)"
  },
