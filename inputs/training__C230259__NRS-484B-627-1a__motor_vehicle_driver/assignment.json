  "law_record": {
    "id": "NRS-484B-627-1a",
    "title": "Duties of driver or operator driving or operating motor vehicle at speed so slow as to impede forward movement of traffic (1)(a)",
    "text": "If any driver or operator of a motor vehicle drives or operates a motor vehicle at a speed so slow as to impede the forward movement of traffic proceeding immediately behind the driver or operator, the driver or operator shall: If the highway has one lane for traveling in each direction and the width of the paved portion permits, drive to the extreme right side of the highway and, if applicable, comply with the provisions of NRS 484B.630.",
    "source": "NRS 484B.627(1)(a)"
  },
  "summary": {
    "activation_conditions": [
      "the subject drives so slowly as to impede the traffic immediately behind",
      "the highway has one lane in each direction",
      "the width of the paved portion permits moving right"
    ],
    "exceptions": [
      "where the paved width does not permit"
    ],
    "id": "NRS-484B-627-1a",
    "residue": [
      "'impede' is a judgement element; and the line hands off to the turnout rule for the rest of the duty"
    ],
    "source": "NRS 484B.627(1)(a)",
    "subject": "driver",
    "theme": "speed",
    "tier": "Q",
    "timing_requirements": [
      {
        "kind": "duration",
        "requirement": "the impeding must persist before the duty arises; the persistence bound must be declared"
      },
      {
        "kind": "ordering",
        "requirement": "the queue forms first, then the move to the right is owed"
      }
    ],
    "title": "Duties of driver or operator driving or operating motor vehicle at speed so slow as to impede forward movement of traffic (1)(a)"
  },
