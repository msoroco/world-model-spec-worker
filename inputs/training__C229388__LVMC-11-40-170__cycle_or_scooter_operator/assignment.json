  "law_record": {
    "id": "LVMC-11-40-170",
    "title": "Parking",
    "text": "It shall be unlawful for any person to park a bicycle, electric bicycle, or electric scooter upon a street other than upon the roadway against the curb or upon the sidewalk in a rack to support the bicycle, electric bicycle, or electric scooter or against a building or at the curb, in such a manner as to afford the least obstruction to pedestrian traffic.",
    "source": "LVMC 11.40.170"
  },
  "summary": {
    "activation_conditions": [
      "the subject parks a bicycle, electric bicycle or electric scooter on a street"
    ],
    "exceptions": [
      "on the roadway against the curb",
      "on the sidewalk in a rack, against a building, or at the curb, so as to afford the least obstruction to pedestrian traffic"
    ],
    "id": "LVMC-11-40-170",
    "residue": [
      "'least obstruction' is a judgement element: a clear-width bound must be declared"
    ],
    "source": "LVMC 11.40.170",
    "subject": "rider",
    "theme": "cycles_and_devices",
    "tier": "Q",
