  "law_record": {
    "id": "NRS-484B-127-2",
    "title": "Following too closely (2)",
    "text": "The driver of any truck or combination of vehicles 80 inches or more in overall width, which is following a truck, or combination of vehicles 80 inches or more in overall width, shall, whenever conditions permit, leave a space of 500 feet so that an overtaking vehicle may enter and occupy such space without danger, but this shall not prevent a truck or combination of vehicles from overtaking and passing any vehicle or combination of vehicles. This subsection does not apply to any vehicle or combination of vehicles while moving on a highway on which there are two or more lanes available for traffic moving in the same direction.",
    "source": "NRS 484B.127(2)"
  },
  "summary": {
    "activation_conditions": [
      "the subject is a truck or combination 80 inches or more in overall width",
      "the vehicle ahead in the same lane is also a truck or combination 80 inches or more wide",
      "the subject is following it",
      "the highway has fewer than two lanes for traffic in the subject's direction"
    ],
    "exceptions": [
      "while overtaking and passing another vehicle or combination",
      "on a highway with two or more lanes available for traffic moving in the same direction",
      "'whenever conditions permit' — the space need not be left where traffic or the road makes it impossible"
    ],
    "id": "NRS-484B-127-2",
    "residue": [
      "'whenever conditions permit' is a judgement element",
      "overall width of a non-subject vehicle can only be estimated from kin.extent"
    ],
    "source": "NRS 484B.127(2)",
    "subject": "truck_driver",
    "theme": "following",
    "tier": "Q",
    "timing_requirements": [
      {
        "kind": "continuous",
        "requirement": "the 500-foot space is a standing requirement while following, not a single-instant test"
      },
      {
        "kind": "duration",
        "requirement": "a momentary closure during and immediately after an overtake is excepted; a bound on how long the gap may be short must be declared"
      }
    ],
    "title": "Following too closely (2)"
  },
