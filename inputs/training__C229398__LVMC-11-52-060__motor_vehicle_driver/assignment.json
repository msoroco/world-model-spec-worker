    "id": "LVMC-11-52-060",
    "title": "Projection into street",
    "text": "In no case shall any part of any vehicle, part of the load of such vehicle or trailer attached to such vehicle, project into the street more than fifteen feet measured on a line at right angles to the curb.",
    "source": "LVMC 11.52.060"
  },
