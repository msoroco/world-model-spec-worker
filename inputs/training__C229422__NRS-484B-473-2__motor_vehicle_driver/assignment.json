  "law_record": {
    "id": "NRS-484B-473-2",
    "title": "Parked vehicle at nighttime (2)",
    "text": "Whenever lights are displayed upon a vehicle lawfully parked at nighttime upon any highway, such lights shall be depressed or dimmed, in the event cowl or parking lamps are not used.",
    "source": "NRS 484B.473(2)"
  },
  "summary": {
    "activation_conditions": [
      "the vehicle is lawfully parked on a highway at nighttime",
      "lights are displayed on it",
      "cowl or parking lamps are not in use"
    ],
    "exceptions": [
      "where cowl or parking lamps are used, the depressing or dimming requirement does not apply"
    ],
    "id": "NRS-484B-473-2",
    "residue": [
      "'lawfully parked' is a reference to the parking rules — rule composition"
    ],
    "source": "NRS 484B.473(2)",
