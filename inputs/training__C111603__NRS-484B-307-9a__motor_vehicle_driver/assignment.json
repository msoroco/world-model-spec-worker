  "law_record": {
    "id": "NRS-484B-307-9a",
    "title": "Traffic controlled by official traffic-control devices (9)(a)",
    "text": "Where the signal is a steady red with a green turn arrow: Except as otherwise provided in paragraph (b) [NRS-484B-307-9b], vehicular traffic facing the signal may enter the intersection only to make the movement indicated by the green turn arrow, but must yield the right-of-way to pedestrians lawfully within an adjacent crosswalk and to other traffic lawfully using the intersection. Drivers turning in the direction of the arrow are thereby advised that so long as the turn arrow is illuminated, oncoming or opposing traffic simultaneously faces a steady red signal.",
    "source": "NRS 484B.307(9)(a)"
  },
  "summary": {
    "activation_conditions": [
      "a steady red with a green turn arrow faces the subject",
      "the subject enters the intersection"
    ],
    "exceptions": [
