  "law": {
    "id": "LVMC-11-16-040",
    "title": "Intersections",
    "text": "The prima facie speed limit shall be fifteen miles per hour when traversing any intersection or street or highway if during the last one hundred feet of his approach to such intersection the driver does not have a clear and unobstructed view of such intersection and of any traffic upon all of the streets or highways entering such intersection for a distance of one hundred feet along all such streets or highways, except on a through street or highway or at a traffic-controlled intersection.",
    "source": "LVMC 11.16.040"
  },
