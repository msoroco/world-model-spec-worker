  "law_record": {
    "id": "LVMC-11-12-070-B",
    "title": "Entering a through highway (B)",
    "text": "Said driver having so yielded may proceed and the drivers of all other vehicles approaching the intersection on the through highway shall yield right-of-way to the vehicle about to enter or cross the through highway.",
    "source": "LVMC 11.12.070(B)"
  },
  "summary": {
    "activation_conditions": [
      "a driver has yielded as the preceding subsection requires and is entering or crossing the through highway",
      "the subject approaches the intersection on the through highway"
    ],
    "exceptions": [],
    "id": "LVMC-11-12-070-B",
    "residue": [
      "the duty is conditional on the other driver having lawfully yielded first: rule composition with the preceding subsection"
    ],
    "source": "LVMC 11.12.070(B)",
    "subject": "driver",
    "theme": "intersections_and_right_of_way",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "ordering",
        "requirement": "the yielding driver's earlier stop and yield precede the subject's duty — the whole sequence must be in the trace"
      },
      {
        "kind": "continuous",
        "requirement": "the duty lasts until the entering vehicle has cleared"
      }
    ],
