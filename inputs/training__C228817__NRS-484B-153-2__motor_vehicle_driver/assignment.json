  "law_record": {
    "id": "NRS-484B-153-2",
    "title": "Boarding or alighting from vehicle (2)",
    "text": "A person shall not open the door of or board or alight from the side of a vehicle which is closest to passing traffic in such a manner as to interfere with moving vehicular traffic.",
    "source": "NRS 484B.153(2)"
  },
  "summary": {
    "activation_conditions": [
      "a person opens a door, boards or alights",
      "the door or the movement is on the side of the vehicle closest to passing traffic",
      "there is moving vehicular traffic on that side"
    ],
    "exceptions": [],
    "id": "NRS-484B-153-2",
    "residue": [
      "'in such a manner as to interfere' is a judgement element requiring a declared bound"
    ],
    "source": "NRS 484B.153(2)",
    "subject": "occupant",
    "theme": "doors_and_boarding",
    "tier": "Q",
    "timing_requirements": [
      {
        "kind": "point_event",
        "requirement": "the opening is the act; interference is judged in the window around it"
      },
      {
        "kind": "ordering",
        "requirement": "the passing user's evasive action must follow the door's movement for the interference to be attributable to it"
      }
    ],
    "title": "Boarding or alighting from vehicle (2)"
  },
