  "law_record": {
    "id": "NRS-484B-283-1d4",
    "title": "Right-of-way in crosswalk (1)(d)(4)",
    "text": "Except as otherwise provided in NRS 484B.287 [NRS-484B-287-1c, NRS-484B-287-1d, NRS-484B-287-1e, LVMC-11-30-060-A, LVMC-11-30-060-B], 484B.290 [LVMC-11-30-140-B] and 484B.350 [LVMC-11-46-030]: Whenever signals exhibiting the words “Walk,” “Don’t Walk,” “Wait” or similar symbols are in place, such signals indicate as follows: While the “Don’t Walk” or “Wait” indication or an upraised hand symbol is illuminated and steady a pedestrian may not proceed to cross the highway, but a pedestrian who entered the highway lawfully pursuant to subparagraph (1) or (2) [NRS-484B-283-1d1, NRS-484B-283-1d2] may continue to cross the highway but must proceed to a curb, sidewalk, safety zone if one is provided or other place of safety as soon as possible.",
    "source": "NRS 484B.283(1)(d)(4)"
  },
  "summary": {
    "activation_conditions": [
      "the pedestrian signal shows a steady don't-walk or upraised hand",
      "the subject is a pedestrian at or in the crossing"
    ],
    "exceptions": [
      "a pedestrian who entered lawfully on the walk indication, or during a countdown, may continue and must proceed to a place of safety as soon as possible"
    ],
    "id": "NRS-484B-283-1d4",
    "residue": [
      "'as soon as possible' is a judgement element: a progress or delay bound must be declared"
    ],
    "source": "NRS 484B.283(1)(d)(4)",
    "subject": "pedestrian",
    "theme": "pedestrian_duties",
    "tier": "Q",
    "timing_requirements": [
      {
        "kind": "point_event",
        "requirement": "entering on a steady indication is the violation"
      },
      {
        "kind": "continuous",
        "requirement": "for a pedestrian already crossing, progress toward safety must be maintained — a stop or a reversal is the failure"
      }
    ],
    "title": "Right-of-way in crosswalk (1)(d)(4)"
  },
