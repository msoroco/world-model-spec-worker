  "law_record": {
    "id": "NRS-484B-533",
    "title": "Unattended motor vehicle",
    "text": "A vehicle shall not be permitted to stand unattended upon any perceptible grade without stopping the engine and effectively setting the brake thereon and turning the front wheels to the curb or side of the highway.",
    "source": "NRS 484B.533"
  },
  "summary": {
    "activation_conditions": [
      "the vehicle stands unattended on a perceptible grade"
    ],
    "exceptions": [],
    "id": "NRS-484B-533",
    "residue": [
      "the engine state, the parking brake and the steer angle are control state a source observes on an instrumented vehicle only (capability subject); a source without them reports unknown, and 'effectively' set is the brake holding the vehicle, read from the absence of motion",
      "'unattended' is judged by occupancy, which a source may not resolve"
    ],
    "source": "NRS 484B.533",
    "subject": "driver",
    "theme": "stopping_standing_parking",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "continuous",
        "requirement": "the wheel position is judged for the whole time the vehicle stands unattended"
      },
      {
        "kind": "ordering",
        "requirement": "the wheels must be turned before the driver leaves, so the frames around the departure are the ones that decide"
      }
    ],
    "title": "Unattended motor vehicle"
  },
