  "law_record": {
    "id": "NRS-484B-307-5a",
    "title": "Traffic controlled by official traffic-control devices (5)(a)",
    "text": "Where the signal is a green straight-through arrow alone: Vehicular traffic facing the signal may proceed straight through, but must not turn right or left. Such vehicular traffic must yield the right-of-way to other vehicles and to pedestrians lawfully within the intersection or an adjacent crosswalk at the time the signal is exhibited.",
    "source": "NRS 484B.307(5)(a)"
  },
