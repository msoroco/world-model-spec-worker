  "law_record": {
    "id": "NRS-484B-263",
    "title": "Vehicle entering or exiting controlled-access highway",
    "text": "The driver of a vehicle about to enter or exit a controlled-access highway shall yield the right-of-way to all vehicles approaching on the highway whose proximity constitutes an immediate hazard and shall continue to yield the right-of-way to that traffic until the driver may proceed with reasonable safety.",
    "source": "NRS 484B.263"
  },
  "summary": {
    "activation_conditions": [
      "the subject is about to enter or exit a controlled-access highway",
      "a vehicle approaching on the highway is close enough to be an immediate hazard"
    ],
    "exceptions": [],
    "id": "NRS-484B-263",
    "residue": [
      "'immediate hazard' and 'reasonable safety' are judgement elements needing declared bounds"
    ],
    "source": "NRS 484B.263",
