  "law": {
    "id": "NRS-484B-100",
    "title": "Obedience to police officer",
    "text": "It is a misdemeanor for any person willfully to fail or refuse to comply with any lawful order or direction of any police officer while the officer is performing the duties of the officer in the enforcement of chapters 484A to 484E, inclusive, of NRS.",
    "source": "NRS 484B.100"
  },
  "summary": {
    "activation_conditions": [
      "a police officer gives a lawful order or direction",
      "the officer is enforcing the traffic chapters",
      "the direction is addressed to the subject"
    ],
    "exceptions": [],
    "id": "NRS-484B-100",
    "residue": [
      "'willfully' and the lawfulness of the order are interior state and a legal question; neither is observable — the rule can only witness non-compliance with an observed indication"
    ],
    "source": "NRS 484B.100",
    "subject": "any_person",
    "theme": "officers_and_flaggers",
    "tier": "Q",
    "timing_requirements": [
      {
        "kind": "ordering",
        "requirement": "the failure to comply is judged after the direction is given and observed"
      },
      {
        "kind": "span",
        "requirement": "the trace must cover both the indication and enough of the subject's subsequent motion to show compliance or refusal"
      }
    ],
    "title": "Obedience to police officer"
  },
