  "law": {
    "id": "NRS-484B-207-1",
    "title": "Overtaking vehicle on left side (1)",
    "text": "The driver of a vehicle overtaking another vehicle proceeding in the same direction shall pass to the left thereof at a safe distance and shall not again drive to the right side of the highway until safely clear of the overtaken vehicle.",
    "source": "NRS 484B.207(1)"
  },
  "summary": {
    "activation_conditions": [
      "the subject overtakes another vehicle proceeding in the same direction"
    ],
    "exceptions": [],
    "id": "NRS-484B-207-1",
    "residue": [
      "'a safe distance' and 'safely clear' are judgement elements: a lateral clearance bound and a post-pass time gap must be declared"
    ],
    "source": "NRS 484B.207(1)",
    "subject": "driver",
    "theme": "overtaking",
    "tier": "Q",
    "timing_requirements": [
      {
        "kind": "ordering",
        "requirement": "the return to the right may not begin until the subject is safely clear of the overtaken vehicle — pass, clear, then return"
      },
      {
        "kind": "continuous",
        "requirement": "the safe lateral distance is required for the whole of the abreast phase"
      },
      {
        "kind": "span",
        "requirement": "the trace must cover the manoeuvre from behind to clear ahead; a fragment cannot decide it"
      }
    ],
    "title": "Overtaking vehicle on left side (1)"
  },
