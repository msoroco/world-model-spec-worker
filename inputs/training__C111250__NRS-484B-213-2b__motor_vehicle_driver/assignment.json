  "law_record": {
    "id": "NRS-484B-213-2b",
    "title": "Limitations on overtaking on left side (2)(b)",
    "text": "A vehicle must not be driven to the left side of the highway at any time: When approaching within 100 feet or traversing any intersection or railroad grade crossing. Subsection 2 does not apply upon a one-way highway.",
    "source": "NRS 484B.213(2)(b); with 484B.213(3)"
  },
  "summary": {
    "activation_conditions": [
      "the subject is within 100 feet of an intersection or railroad grade crossing, or is traversing one",
      "the subject drives left of the centre of the highway"
    ],
    "exceptions": [
      "the rule does not apply on a one-way highway"
    ],
    "id": "NRS-484B-213-2b",
    "residue": [],
    "source": "NRS 484B.213(2)(b); with 484B.213(3)",
    "subject": "driver",
    "theme": "overtaking",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "continuous",
        "requirement": "the prohibition holds for every instant inside the 100-foot zone and while traversing"
      },
      {
        "kind": "ordering",
        "requirement": "a pass begun earlier must be completed and the vehicle back on the right before the 100-foot zone starts"
      }
    ],
    "title": "Limitations on overtaking on left side (2)(b)"
  },
