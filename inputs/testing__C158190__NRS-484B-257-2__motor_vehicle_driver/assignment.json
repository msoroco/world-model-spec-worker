  "law": {
    "id": "NRS-484B-257-2",
    "title": "Vehicle entering intersection marked stop or yield (2)",
    "text": "Except when traffic is being controlled by a police officer or a traffic-control signal: The driver of a vehicle shall stop in obedience to a stop sign or yield in compliance with a yield sign, in compliance with the manner prescribed in subsection 1 [NRS-484B-257-1], prior to entering an intersection if a stop sign or a yield sign is erected at one or more entrances thereto although not a part of a through highway and shall proceed cautiously, yielding to vehicles not so obligated to stop or yield and which are within the intersection or approaching so closely as to constitute an immediate hazard during the time such driver is moving across or within the intersection.",
    "source": "NRS 484B.257(2)"
  },
  "summary": {
    "activation_conditions": [
      "a stop or yield sign is erected at one or more entrances to the intersection, although it is not part of a through highway",
      "the subject approaches on a signed entrance",
      "traffic is not controlled by a police officer or a signal"
    ],
    "exceptions": [
      "when traffic is being controlled by a police officer",
      "when traffic is being controlled by a traffic-control signal"
    ],
    "id": "NRS-484B-257-2",
    "residue": [
      "'proceed cautiously' and 'immediate hazard' are judgement elements",
      "which other approaches carry signs decides who is 'not so obligated': every lane entering the intersection (st.lane_enters) and the devices governing each are read"
    ],
    "source": "NRS 484B.257(2)",
    "subject": "driver",
    "theme": "intersections_and_right_of_way",
    "tier": "Q",
    "timing_requirements": [
      {
        "kind": "ordering",
        "requirement": "stop or yield before entering, then proceed"
      },
      {
        "kind": "continuous",
        "requirement": "the yield continues while the subject moves across or within the intersection"
      }
    ],
    "title": "Vehicle entering intersection marked stop or yield (2)"
  },
