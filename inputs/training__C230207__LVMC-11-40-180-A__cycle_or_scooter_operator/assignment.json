  "law_record": {
    "id": "LVMC-11-40-180-A",
    "title": "Sidewalk riding (A)",
    "text": "It shall be unlawful for any person to ride a bicycle, electric bicycle, or electric scooter upon the sidewalks on Fremont Street between Main Street and Seventh Street. This area shall be posted with signs indicating that the riding of bicycles, electric bicycles, or electric scooters on the sidewalk is prohibited.",
    "source": "LVMC 11.40.180(A)"
  },
