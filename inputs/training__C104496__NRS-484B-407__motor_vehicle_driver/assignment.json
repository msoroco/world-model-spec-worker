  "law_record": {
    "id": "NRS-484B-407",
    "title": "Turning on curve or crest of grade prohibited in certain circumstances",
    "text": "A vehicle shall not be turned so as to proceed in the opposite direction upon any curve, or upon the approach to or near the crest of a grade, where such vehicle cannot be seen by the driver of any other vehicle approaching from either direction within 500 feet.",
    "source": "NRS 484B.407"
  },
  "summary": {
    "activation_conditions": [
      "the subject turns to proceed in the opposite direction",
      "the place is a curve, or the approach to or near the crest of a grade",
      "the subject cannot be seen from 500 feet by a driver approaching from either direction"
    ],
    "exceptions": [],
    "id": "NRS-484B-407",
    "residue": [
      "the 500-foot visibility is a sight-line construction: as good as st.sight_distance on the source, and it must be computed in both directions"
    ],
    "source": "NRS 484B.407",
    "subject": "driver",
