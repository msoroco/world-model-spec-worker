  "law": {
    "id": "LVMC-11-12-100-C",
    "title": "Two-way left-turn lanes (C)",
    "text": "A vehicle shall not be driven in a designated two-way left-turn lane except when preparing for or making a left turn. A left turn shall not be made from any other lane where a two-way left-turn lane has been designated.",
    "source": "LVMC 11.12.100(C)"
  },
  "summary": {
    "activation_conditions": [
      "a two-way left-turn lane is designated on the highway",
      "the subject is driven in it, or makes a left turn from another lane"
    ],
    "exceptions": [
      "driving in the lane while preparing for or making a left turn"
    ],
    "id": "LVMC-11-12-100-C",
    "residue": [
      "'preparing for' a turn is intention; the turn that follows is the observable evidence"
    ],
    "source": "LVMC 11.12.100(C)",
    "subject": "driver",
    "theme": "lanes",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "span",
        "requirement": "the permitted use is shown by the turn that follows the occupancy, so entry and turn must both be in the trace"
      },
      {
        "kind": "point_event",
        "requirement": "a left turn made from another lane is the second, independent violation, judged at the turn"
      }
    ],
    "title": "Two-way left-turn lanes (C)"
  },
