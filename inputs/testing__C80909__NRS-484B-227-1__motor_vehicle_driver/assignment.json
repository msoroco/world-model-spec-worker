  "law": {
    "id": "NRS-484B-227-1",
    "title": "Driving on divided highway (1)",
    "text": "Every vehicle driven upon a divided highway must be driven only upon the right-hand roadway and must not be driven over, across or within any dividing space, barrier or section or make any left turn, semicircular turn or U-turn, except through an opening in the barrier or dividing section or space or at a crossover or intersection established by a public authority.",
    "source": "NRS 484B.227(1)"
  },
  "summary": {
    "activation_conditions": [
      "the highway is divided",
      "the subject is driven on it"
    ],
    "exceptions": [
      "through an opening in the barrier, dividing section or space",
      "at a crossover or intersection established by a public authority"
    ],
    "id": "NRS-484B-227-1",
    "residue": [
      "whether a crossover was 'established by a public authority' is an administrative fact; the observable substitute is the physical opening"
    ],
    "source": "NRS 484B.227(1)",
    "subject": "driver",
    "theme": "roadway_position",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "continuous",
        "requirement": "the right-hand-roadway duty holds at every instant"
      },
      {
        "kind": "point_event",
        "requirement": "the crossing of the dividing space, or the turn, is the act judged"
      }
    ],
    "title": "Driving on divided highway (1)"
  },
