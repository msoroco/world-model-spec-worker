  "law_record": {
    "id": "NRS-484B-267-1c",
    "title": "Operation of vehicle on approach of authorized emergency vehicle or official vehicle of regulatory agency (1)(c)",
    "text": "Upon the immediate approach of an authorized emergency vehicle or an official vehicle of a regulatory agency, making use of flashing lights meeting the requirements of subsection 3 of NRS 484A.480 [DEF-NRS-484A-480-3], the driver of every other vehicle shall, except when otherwise directed by a law enforcement officer: Stop and remain in such position until the authorized emergency vehicle or official vehicle has passed.",
    "source": "NRS 484B.267(1)(c)"
  },
  "summary": {
    "activation_conditions": [
      "the subject has taken the required position on the immediate approach of the emergency or official vehicle"
    ],
    "exceptions": [
      "when otherwise directed by a law enforcement officer"
    ],
    "id": "NRS-484B-267-1c",
    "residue": [],
    "source": "NRS 484B.267(1)(c)",
    "subject": "driver",
    "theme": "emergency_and_incident",
    "tier": "C",
    "timing_requirements": [
      {
        "kind": "until",
        "requirement": "the halt persists until the emergency or official vehicle has passed; moving off earlier is the violation"
      },
      {
        "kind": "span",
        "requirement": "the trace must cover the passing for the release condition to be observable"
      }
    ],
    "title": "Operation of vehicle on approach of authorized emergency vehicle or official vehicle of regulatory agency (1)(c)"
  },
