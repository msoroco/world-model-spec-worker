  "law_record": {
    "id": "LVMC-11-60-040",
    "title": "Taxi stopping, standing or parking",
    "text": "The operator of a taxicab shall not stand or park such vehicle upon any street at any place other than in a taxicab stand so designated as provided herein. This provision shall not prevent the operator of a taxicab from temporarily stopping in accordance with other stopping or parking regulations at any place for the purpose of and while actually engaged in the expeditious loading or unloading of passengers.",
    "source": "LVMC 11.60.040"
  },
  "summary": {
    "activation_conditions": [
      "the subject operates a taxicab",
      "it stands or parks on a street at a place other than a designated taxicab stand"
    ],
    "exceptions": [
      "temporarily stopping, in accordance with the other stopping and parking regulations, while actually engaged in the expeditious loading or unloading of passengers"
    ],
    "id": "LVMC-11-60-040",
    "residue": [
      "the exception is conditional on compliance with the other parking rules: rule composition"
    ],
