  "law": {
    "id": "NRS-484D-215-2",
    "title": "Use of equipment for lighting road with multiple beams (2)",
    "text": "Whenever a motor vehicle is being operated on the traveled portion of the highway, or shoulder adjacent thereto, during the times specified in NRS 484D.100 [NRS-484D-100-1], the driver shall use a distribution of light, or composite beam, directed high enough and of sufficient intensity to reveal persons and vehicles at a safe distance in advance of the vehicle, subject to the following requirements and limitations: Whenever the driver of a vehicle follows another vehicle within 300 feet to the rear, the driver shall use a distribution of light permissible under this chapter other than the uppermost distribution of light specified in subsection 1 of NRS 484D.210 [DEF-NRS-484D-210-1-2].",
    "source": "NRS 484D.215(2)"
  },
  "summary": {
    "activation_conditions": [
