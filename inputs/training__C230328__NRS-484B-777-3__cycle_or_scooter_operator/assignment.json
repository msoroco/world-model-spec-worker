  "law_record": {
    "id": "NRS-484B-777-3",
    "title": "Operating bicycle, electric bicycle or electric scooter on roadway (3)",
    "text": "Persons riding bicycles, electric bicycles or electric scooters upon a roadway shall not ride more than two abreast except on paths or parts of roadways set aside for the exclusive use of bicycles, electric bicycles and electric scooters.",
    "source": "NRS 484B.777(3)"
  },
