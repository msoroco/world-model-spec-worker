{
  "format": "worker-measurement-contract-v1",
  "requirements": [
    {
      "disposition_index": 0,
      "requirement": "Qualifying driver, vehicle and public-highway scope",
      "source": "NRS 484B.600(1)(a)",
      "output_key": "speed_driver_scope",
      "method": "actor_scope",
      "kind": "sourced_context",
      "value_type": "object",
      "inputs": [
        "law_context.json"
      ]
    },
    {
      "disposition_index": 1,
      "requirement": "Retain contemporaneous traffic, full road width, paved surface, weather and measured visibility",
      "source": "NRS 484B.600(1)(a)",
      "output_key": "traffic_surface_weather_context",
      "method": "conditions_context",
      "kind": "measured",
      "value_type": "object",
      "inputs": [
        "conditions.jsonl",
        "road_geometry.json",
        "environment_calibration.json",
        "surface_provenance.json"
      ]
    },
    {
      "disposition_index": 2,
      "requirement": "Record actual speed and velocity throughout the changing conditions",
      "source": "NRS 484B.600(1)(a)",
      "output_key": "speed_velocity_series",
      "method": "speed_series",
      "kind": "measured",
      "value_type": "object",
      "inputs": [
        "motion_samples.jsonl"
      ]
    },
    {
      "disposition_index": 3,
      "requirement": "Compare measured speed with an explicitly assumed stopping envelope and sampled visibility without deciding reasonable or proper",
      "source": "NRS 484B.600(1)(a)",
      "output_key": "stopping_sight_envelope",
      "method": "stopping_envelope",
      "kind": "measured",
      "value_type": "object",
      "inputs": [
        "motion_samples.jsonl",
        "conditions.jsonl",
        "environment_calibration.json",
        "law_context.json"
      ]
    }
  ],
  "negative": {
    "remove": [
      "motion_samples.jsonl"
    ],
    "error_contains": "Missing required source: motion_samples.jsonl"
  }
}
