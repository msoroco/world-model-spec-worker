{
  "format": "worker-measurement-contract-v1",
  "requirements": [
    {
      "disposition_index": 0,
      "requirement": "Business-district highway frontage and loading-zone location select the 100-foot branch",
      "source": "NRS 484B.413(2)",
      "output_key": "business_district_scope",
      "method": "district_scope",
      "kind": "sourced_context",
      "value_type": "object",
      "inputs": [
        "law_context.json"
      ]
    },
    {
      "disposition_index": 1,
      "requirement": "Measure actual right-indicator display continuously in sampled last 100 feet of traveled approach",
      "source": "NRS 484B.413(2)",
      "output_key": "right_signal_100ft_samples",
      "method": "signal_continuity",
      "kind": "measured",
      "value_type": "object",
      "inputs": [
        "signal_samples.jsonl"
      ]
    },
    {
      "disposition_index": 2,
      "requirement": "Retain approach path and ensuing right-turn course-change event",
      "source": "NRS 484B.413(2)",
      "output_key": "right_turn_course_samples",
      "method": "turn_event",
      "kind": "measured",
      "value_type": "object",
      "inputs": [
        "motion_samples.jsonl",
        "law_context.json"
      ]
    },
    {
      "disposition_index": 3,
      "requirement": "Qualifying vehicle and physically controlling driver",
      "source": "NRS 484B.413(2)",
      "output_key": "signal_driver_scope",
      "method": "actor_scope",
      "kind": "sourced_context",
      "value_type": "object",
      "inputs": [
        "law_context.json"
      ]
    }
  ],
  "negative": {
    "remove": [
      "signal_samples.jsonl"
    ],
    "error_contains": "Missing required source: signal_samples.jsonl"
  }
}
