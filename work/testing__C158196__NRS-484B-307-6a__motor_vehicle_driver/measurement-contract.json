      "kind": "measured",
      "value_type": "object",
      "inputs": [
        "case_observations.jsonl"
      ]
    },
    {
      "disposition_index": 2,
      "requirement": "Compare the first full-body intersection-entry frame with the first red exhibition frame",
      "source": "NRS 484B.307(6)(a)",
      "output_key": "red_entry_timing",
