{
  "format": "worker-measurement-contract-v1",
  "requirements": [
    {
      "disposition_index": 0,
      "requirement": "Identify qualifying driver, public highway, two moving vehicles and actual following interval before lane change",
      "source": "NRS 484B.127(1)",
      "output_key": "following_activation",
      "method": "following_scope",
      "kind": "sourced_context",
      "value_type": "object",
      "inputs": [
        "law_context.json",
        "road_geometry.json"
      ]
    },
    {
      "disposition_index": 1,
      "requirement": "Measure full-body longitudinal separation, both speeds and time gap for every following sample without a legal cutoff",
      "source": "NRS 484B.127(1)",
      "output_key": "original_following_gaps",
      "method": "following_gap",
      "kind": "measured",
      "value_type": "object",
      "inputs": [
        "case_observations.jsonl"
      ]
    },
    {
      "disposition_index": 2,
      "requirement": "Retain surrounding traffic and highway surface/weather conditions through the following interval",
      "source": "NRS 484B.127(1)",
      "output_key": "following_conditions",
      "method": "following_conditions",
      "kind": "measured",
      "value_type": "object",
      "inputs": [
        "case_observations.jsonl",
        "law_context.json"
      ]
    }
  ],
  "negative": {
    "remove": [
      "case_observations.jsonl"
    ],
