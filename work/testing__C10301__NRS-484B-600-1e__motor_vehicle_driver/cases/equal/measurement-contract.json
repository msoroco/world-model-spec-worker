      "method": "speed_history",
      "output_key": "original_speed_history",
      "inputs": [
        "speed_samples.jsonl"
      ],
      "kind": "measured",
      "value_type": "object"
    },
    {
      "disposition_index": 1,
      "requirement": "Establish qualifying operation and source context for the actual highway portion.",
      "source": "NRS 484B.600(1)(e)",
      "method": "highway_context",
      "output_key": "highway_context",
      "inputs": [
        "alley_context.json"
      ],
      "kind": "measured",
      "value_type": "object"
    }
  ],
  "negative": {
    "remove": [
      "speed_samples.jsonl"
    ],
    "error_contains": "Missing required source: speed_samples.jsonl"
  }
