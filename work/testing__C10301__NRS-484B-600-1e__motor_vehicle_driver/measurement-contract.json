{
  "format": "worker-measurement-contract-v1",
  "requirements": [
    {
      "disposition_index": 0,
      "requirement": "Qualifying operation of a conventional vehicle on the selected alley route with an actual marked access aisle retained",
      "source": "NRS 484B.600(1)(e)",
      "output_key": "alley_access_scope",
      "method": "access_aisle_scope",
      "kind": "sourced_context",
      "value_type": "object",
      "inputs": [
        "law_context.json",
        "road_geometry.json"
      ]
    },
    {
      "disposition_index": 1,
      "requirement": "Measure speed in mph at every original frame and compare samples to the unconditional 80 mph cap",
      "source": "NRS 484B.600(1)(e)",
      "output_key": "absolute_speed_samples",
      "method": "absolute_speed_cap",
      "kind": "measured",
      "value_type": "object",
      "inputs": [
        "case_observations.jsonl"
      ]
    }
  ],
  "negative": {
    "remove": [
      "case_observations.jsonl"
    ],
    "error_contains": "Missing required source: case_observations.jsonl"
  }
}
