{
  "format": "worker-measurement-contract-v1",
  "requirements": [
    {
      "disposition_index": 0,
      "requirement": "Identify installed, uncovered governing official vehicular signals and complete inoperability at entry",
      "source": "NRS 484B.250(4)",
      "output_key": "inoperative_signal_at_entry",
      "method": "inoperative_signal_scope",
      "kind": "measured",
      "value_type": "object",
      "inputs": [
        "case_observations.jsonl",
        "law_context.json"
      ]
    },
    {
      "disposition_index": 1,
      "requirement": "Measure full cessation before the clearly marked stop line and preserve the ordering before intersection entry",
      "source": "NRS 484B.250(4)",
      "output_key": "stop_line_halt_samples",
      "method": "stop_line_halt",
      "kind": "measured",
      "value_type": "object",
      "inputs": [
        "case_observations.jsonl",
        "road_geometry.json"
      ]
    },
    {
      "disposition_index": 2,
      "requirement": "Retain synchronized earlier stop-completion histories and intersection occupancy of distinct counterpart vehicles for yielding review",
      "source": "NRS 484B.250(4)",
      "output_key": "counterpart_priority_history",
      "method": "priority_history",
      "kind": "measured",
      "value_type": "object",
      "inputs": [
        "case_observations.jsonl"
      ]
    },
    {
      "disposition_index": 3,
      "requirement": "Preserve all entrance boundaries, driver viewpoint and actual sight-obstruction geometry without a numeric caution standard",
      "source": "NRS 484B.250(4)",
      "output_key": "blind_intersection_sight_context",
      "method": "blind_sight_scope",
      "kind": "measured",
      "value_type": "object",
      "inputs": [
        "law_context.json",
        "road_geometry.json",
        "case_observations.jsonl"
      ]
    }
  ],
  "negative": {
    "remove": [
      "case_observations.jsonl"
    ],
    "error_contains": "Missing required source: case_observations.jsonl"
  }
}
